{
  "editor.formatOnSave": true,
  "[ruby]": {
    "editor.defaultFormatter": "rubocop.vscode-rubocop",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file"
  },
  "rubyLsp.formatter": "syntax_tree",
  "rubyLsp.rubyVersionManager": {
    "identifier": "mise"
  },
  "files.associations": {
    "/home/jp/.rbenv/**/lib/ruby/**/*.rb": "plaintext"
  },
  "[erb]": {
    "editor.defaultFormatter": "aliariff.vscode-erb-beautify",
    "editor.formatOnSave": true
  },
  "vscode-erb-beautify.useBundler": true,
  "vscode-erb-beautify.bundlerPath": "bundle"
}
