<% Event.where(status: "created").each do |event| %>
  <!-- Event -->
  <div class="flex-between" style="background-color: yellow; border-bottom: 1px solid black;">
    <h4 style="margin: 5px; padding: 5px;"><span style="font-weight: bold;"><%= event.name %></span> @ 
      <%= event.date_event&.strftime("%A %d-%b-%Y") %> |
      <%= event.tour.name %>
    </h4>
    <div>
      <% if event.status == "running" %>
        <%= link_to "Open", admin_tour_event_path(event.tour, event, page: "ldb"), class: "btt btt-open" %>
      <% end %>
      <% if event.status=="registration" %>
        <%= link_to "Open" , admin_tour_event_path(event.tour, event, page: "event-entries" ), class: "btt btt-open" %>
      <% end %>
      <% if event.status == "created" || event.status == "pending" %>
        <%= link_to "Open" , admin_tour_event_path(event.tour, event, page: "rounds" ), class: "btt btt-open" %>
      <% end %>
    </div>
  </div>
<% end %>