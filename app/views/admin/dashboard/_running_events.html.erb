<% Event.where(status: "running").each do |event| %>
  <!-- Event -->
  <div class="flex-between" style="background-color: lightyellow; border-bottom: 1px solid lightgrey;">
    <h4 style="margin: 5px; padding: 5px;"><span style="font-weight: bold;"><%= event.name %></span> @
      <%= event.date_event&.strftime("%A %d-%b-%Y") %> |
      <%= event.tour.name %>
    </h4>
    <div>
      <% if event.status.in?(["running"]) %>
        <%= link_to "Open", leaderboard_admin_tour_event_path(event.tour, event), class: "btt btt-open" %>
      <% end %>
    </div>
  </div>
  <!-- Rounds -->
  <div style="margin-left: 20px; ">
    <% event.rounds.order(:num).each do |round| %>
      <div class="flex-between" style="border-bottom: 1px solid lightgrey;">
        <h5 style="margin: 5px; padding: 5px;">Round <%= round.num %> - <%= round.status.upcase %></h5>
        <div>
          <% if round.status == "running" %>
            <%= link_to "Scoring" , scoring_admin_round_path(round), class: "btt btt-scoring" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
