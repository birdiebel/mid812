<div id="flights" style="width: 500px;">
  <div class="panel">
    <h3>Flights</h3>
    <div class="panel_contents" style="overflow-y: auto; height: 400px;">
      <% round.config_teetimes.each do |config| %>
        <div class="config-section">
          <h4 style="background-color: green; color: white; padding: 5px; font-weight: bold;"><%= config.course.name %> - Hole <%= config.start_hole %></h4>
          <% config.flights.order(:num).each do |flight| %>
            <div class="flight-item">
              <h4 style="background-color: lightblue; padding: 5px; font-weight: bold;"><strong>Flight <%= flight.num %></strong> - <strong><%= flight.myTime %></strong></h4>
              <% flight.slots.order(:num).each do |slot| %>
                 <div class="slot-item <%= slot.entry ? 'slot-item--occupied' : 'slot-item--empty' %>" 
                     data-slot-id="<%= slot.id %>"
                     <% if slot.entry %>
                       data-entry-id="<%= slot.entry.id %>"
                       data-player-name="<%= slot.entry.player.full_name %>"
                       data-player-cat="<%= slot.entry.playercat_id %>"
                       data-player-cat-name="<%= slot.entry.playercat&.name || 'No Category' %>"
                       data-team-name="<%= slot.entry.licence.club || 'No team' %>"
                       data-hcp="<%= slot.entry.hcp %>"
                       data-teebox="<%= slot.entry.playercat&.teebox || 'x' %>"
                     <% end %>>
                  <strong><%= slot.entry ? slot.entry.player.full_name : "" %></strong>
                  <br>
                  <%= slot.entry ? (slot.entry.licence.club || "No team") : "" %> |
                  <%= slot.entry ? (slot.entry.hcp || "x") : "" %> |
                  <%= slot.entry ? (slot.entry.playercat&.teebox || "x") : "" %> |
                  <% if slot.playing_hcp %>
                    <strong>(PLAYING <%= slot.playing_hcp %>)</strong>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>