<% if slot.team %> <% slot.team.entries.each do |p| %>
<div
  style="display: flex; justify-content: center; align-items: center; gap: 5px"
>
  <div><strong>PHCP: <%= slot.score_playing_hcp_for(p) %></strong></div>
  <div>|</div>
  <div>
    <%= sanitize(p.playercat.icon_teebox, tags: %w[i span], attributes: %w[class
    style]) %>
  </div>
</div>
<% end %> <% end %>
