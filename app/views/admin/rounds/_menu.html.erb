<div name="round-menu" class="button-group" style="margin-top: -30px; margin-bottom: -20px;">
  <a href="#config-times" class="menu-button menu-event-button" data-target="#config-times">
    Config Times
  </a>
  <%= link_to "Start List", start_list_admin_round_path(round), method: :get, class: "menu-button menu-event-button", style: "background-color: #43a047; color: white;" %>

  <%= link_to "Scoring", "/admin/rounds/#{round.id}/scoring", method: :get, class: "menu-button menu-event-button", style: "background-color: #43a047; color: white;" %>

  <a href="#round-details" class="menu-button menu-event-button" data-target="#round-details">
    Round Details
  </a>
  <a href="#status" class="menu-button menu-event-button menu-button-status" data-target="#status">
    <%= round.status.upcase %>
  </a>
</div>

<style>
  .round-menu-section {
    display: none;
  }
</style>
