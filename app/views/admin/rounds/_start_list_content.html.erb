<div class="panel" style="text-align: center;">
  <h3>Start List</h3>
  <div>
    <%= link_to "PDF Start List", pdf_start_list_admin_round_path(@round, format: :pdf), class: "button" %>
  </div>
  <div class="flex-container" style="gap: 20px; justify-content: center; align-items: stretch; height: 70vh;">
    <div style="height: 100%;">
      <%= render partial: "admin/rounds/start_list_flights", locals: { round: @round }, cache: false %>
    </div>
    <div style="height: 100%;">
      <%= render partial: "admin/rounds/start_list_entries", locals: { round: @round } %>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Starting drag & drop initialization...');

    function refreshTeamList() {
      const teamsPanel = document.querySelector('#teams .panel_contents');
      if (teamsPanel) {
        fetch(window.location.pathname, {
          headers: { 'Accept': 'text/html' }
        })
        .then(response => response.text())
        .then(html => {
          const parser = new DOMParser();
          const newDoc = parser.parseFromString(html, 'text/html');
          const newTeamsPanel = newDoc.querySelector('#teams .panel_contents');
          if (newTeamsPanel) {
            teamsPanel.innerHTML = newTeamsPanel.innerHTML;
            makeEntriesDraggable();
            console.log('Team list refreshed successfully');
          } else {
            console.error('Could not find teams panel in response');
          }
        })
        .catch(error => {
          console.error('Error refreshing team list:', error);
        });
      }
    }

    // Function to make teams draggable
    function makeEntriesDraggable() {
      const entries = document.querySelectorAll('.team-item');
      // console.log('Found ' + entries.length + ' teams');

      entries.forEach(team => {
        // Only add listeners if not already added
        if (!team.dataset.draggableInitialized) {
          team.draggable = true;
          team.style.cursor = 'move';
          // console.log('Team', team.getAttribute('data-team-id'), 'made draggable');

          team.addEventListener('dragstart', function(e) {
            // console.log('Dragging team:', this.getAttribute('data-team-id'));
            this.style.opacity = '0.5';
            this.style.backgroundColor = '#e8f5e9';
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', this.getAttribute('data-team-id'));
          });

          team.addEventListener('dragend', function(e) {
            // console.log('Drag ended');
            this.style.opacity = '1';
            this.style.backgroundColor = '';
          });

          team.dataset.draggableInitialized = 'true';
        } else {
          // Already initialized, just ensure cursor is visible if display changed
          if (team.style.display !== 'none') {
            team.style.cursor = 'move';
          }
        }
      });
    }

    // Initialize teams on page load
    // console.log('Calling makeEntriesDraggable on DOMContentLoaded');
    setTimeout(() => {
      makeEntriesDraggable();
    }, 100);

    // Function to swap or move teams between slots
    function handleSlotSwap(sourceSlotId, destSlotId) {
      const sourceSlot = document.querySelector(`[data-slot-id="${sourceSlotId}"]`);
      const destSlot = document.querySelector(`[data-slot-id="${destSlotId}"]`);

      if (!sourceSlot || !destSlot) {
        console.error('One or both slots not found');
        return;
      }

      // Get the team IDs from both slots
      const sourceTeamId = sourceSlot.getAttribute('data-team-id');
      const destTeamId = destSlot.getAttribute('data-team-id');

      // console.log('Slot action: source team', sourceTeamId, ', dest team', destTeamId);

      const token = document.querySelector('meta[name="csrf-token"]');
      if (!token) {
        console.error('CSRF token not found');
        return;
      }

      // If destination slot is empty, just move the team
      if (sourceTeamId && !destTeamId) {
        // console.log('Moving team', sourceTeamId, 'to empty slot', destSlotId);

        // First, clear the source slot in DB
        fetch(`/api/v1/slots/${sourceSlotId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': token.content
          },
          body: JSON.stringify({ slot: { team_id: null } })
        })
        .then(response => {
          if (!response.ok) throw new Error('Failed to clear source slot');
          return response.json();
        })
        .then(() => {
          // Then move team to destination slot
          return fetch(`/api/v1/slots/${destSlotId}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': token.content
            },
            body: JSON.stringify({ slot: { team_id: sourceTeamId } })
          });
        })
        .then(response => {
          if (response.ok) return response.json();
          throw new Error('Failed to move team');
        })
        .then(data => {
          // console.log('Team moved successfully');

          // Clear the source slot UI
          sourceSlot.innerHTML = '<strong></strong><br>';
          sourceSlot.classList.remove('slot-item--occupied');
          sourceSlot.classList.add('slot-item--empty');
          sourceSlot.removeAttribute('data-team-id');
          sourceSlot.removeAttribute('data-team-name');
          sourceSlot.removeAttribute('data-hcp');
          sourceSlot.removeAttribute('data-teebox');

          // Update the destination slot
          updateSlotUI(destSlotId, data.slot);

          // Re-initialize slot draggability
          makeSlotsDraggable();

          // Refresh the team list to show the moved team in the correct place
          refreshTeamList();
        })
        .catch(error => {
          console.error('Move error:', error);
          alert('Error moving team');
        });
      }
      // If both slots have teams, swap them
      else if (sourceTeamId && destTeamId) {
        // console.log('Swapping entries:', sourceTeamId, 'with', destTeamId);

        // First, update source slot with dest team
        fetch(`/api/v1/slots/${sourceSlotId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': token.content
          },
          body: JSON.stringify({ slot: { team_id: destTeamId } })
        })
        .then(response => {
          if (response.ok) return response.json();
          throw new Error('Failed to update source slot');
        })
        .then(data1 => {
          // Then, update dest slot with source team
          return fetch(`/api/v1/slots/${destSlotId}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': token.content
            },
            body: JSON.stringify({ slot: { team_id: sourceTeamId } })
          })
          .then(response => {
            if (response.ok) return response.json();
            throw new Error('Failed to update dest slot');
          })
          .then(data2 => {
            // console.log('Swap completed successfully');

            // Update UI for both slots
            updateSlotUI(sourceSlotId, data1.slot);
            updateSlotUI(destSlotId, data2.slot);

            // Re-initialize slot draggability
            makeSlotsDraggable();
          });
        })
        .catch(error => {
          console.error('Swap error:', error);
          alert('Error swapping players');
        });
      }
    }

    // Dans votre fonction updateSlotUI()
   function updateSlotUI(slotId, slotData) {
    const slotElement = document.querySelector(`[data-slot-id="${slotId}"]`);
     if (!slotElement || !slotData.team || !slotData.team.entries) return;

      const team = slotData.team;
      const teamName = team.team_name || '';

      // Générer le HTML pour chaque entry (joueur)
      const entriesHtml = slotData.team.entries.map(p => {
      const playingHcp = p.playing_hcp || 'x';
      const iconTeebox = p.playercat?.icon_teebox || '';

      return `<div style="display: flex; justify-content: center; align-items: center; gap: 5px;">
             <div>HCP: ${team.total_hcp}</div>
             </div>`;
            }).join('');

      // Construire le HTML final du slot
      slotElement.innerHTML = `
        <strong>${teamName}</strong>
        <br>
      ${team.total_hcp}
    `;

  // Mettre à jour les data attributes
  slotElement.setAttribute('data-team-id', team.id);
  slotElement.setAttribute('data-team-name', team.team_name);
  slotElement.setAttribute('data-hcp', team.total_hcp);
  slotElement.classList.remove('slot-item--empty');
  slotElement.classList.add('slot-item--occupied');
}

    // Make slots with assigned teams draggable
    function makeSlotsDraggable() {
      const occupiedSlots = document.querySelectorAll('.slot-item[data-team-id]');
      // console.log('Found ' + occupiedSlots.length + ' occupied slots');

      occupiedSlots.forEach(slot => {
        slot.draggable = true;
        slot.style.cursor = 'move';

        // Double-click to remove team from slot
        slot.addEventListener('dblclick', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const slotId = this.dataset.slotId;
          const teamId = this.dataset.teamId;
          // console.log('Double-clicked slot', slotId, 'with team', teamId);
          removeTeamFromSlot(slotId, teamId);
        });

        slot.addEventListener('dragstart', function(e) {
          const teamId = this.dataset.teamId;
          const slotId = this.dataset.slotId;
          // console.log('Dragging slot with team:', teamId);

          this.style.opacity = '0.5';
          this.style.backgroundColor = '#ffebee';

          e.dataTransfer.effectAllowed = 'move';
          // Store both slot and team data
          e.dataTransfer.setData('slotId', slotId);
          e.dataTransfer.setData('teamId', teamId);
          e.dataTransfer.setData('teamName', this.dataset.teamName || 'No team');
          e.dataTransfer.setData('hcp', this.dataset.hcp || '0');
          e.dataTransfer.setData('teebox', this.dataset.teebox || 'x');
          e.dataTransfer.setData('source', 'slot');
        });

        slot.addEventListener('dragend', function(e) {
          this.style.opacity = '1';
          this.style.backgroundColor = '';
        });
      });
    }

    // Function to remove team from slot
    function removeTeamFromSlot(slotId, teamId) {
      const token = document.querySelector('meta[name="csrf-token"]');
      if (!token) {
        console.error('CSRF token not found');
        return;
      }

      fetch(`/api/v1/slots/${slotId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': token.content
        },
        body: JSON.stringify({
          slot: {
            team_id: null
          }
        })
      })
      .then(response => {
        if (response.ok) {
          return response.json();
        } else {
          alert('Failed to remove team from slot');
          throw new Error('Failed to update slot');
        }
      })
      .then(data => {
        // console.log('Team removed from slot successfully');

        // Update slot to show "Empty"
        const slotElement = document.querySelector(`[data-slot-id="${slotId}"]`);
        if (slotElement) {
          slotElement.innerHTML = '<strong></strong><br>';
          slotElement.classList.remove('slot-item--occupied');
          slotElement.classList.add('slot-item--empty');

          // Remove data attributes
          slotElement.removeAttribute('data-team-id');
          slotElement.removeAttribute('data-team-name');
          slotElement.removeAttribute('data-hcp');
          slotElement.removeAttribute('data-teebox');
          slotElement.draggable = false;
          slotElement.style.cursor = '';
        }

        // Always reload the teams panel to ensure the team appears
        // console.log('Reloading teams panel to ensure team appears');
        const teamsPanel = document.querySelector('#teams .panel_contents');
        if (teamsPanel) {
          fetch(window.location.pathname, {
            headers: { 'Accept': 'text/html' }
          })
          .then(response => response.text())
          .then(html => {
            const parser = new DOMParser();
            const newDoc = parser.parseFromString(html, 'text/html');
            const newTeamsPanel = newDoc.querySelector('#teams .panel_contents');
            if (newTeamsPanel) {
              teamsPanel.innerHTML = newTeamsPanel.innerHTML;
              makeEntriesDraggable();
              // console.log('Teams panel reloaded successfully');
            } else {
              console.error('Could not find teams panel in response');
            }
          })
          .catch(error => {
            console.error('Error reloading teams panel:', error);
            // Fallback: try to show the team element if it exists
            const teamElement = document.querySelector(`.team-item[data-team-id="${teamId}"]`);
            if (teamElement) {
              teamElement.style.display = '';
              // console.log('Fallback: Team shown in list');
              makeEntriesDraggable();
            }
          });
        }

        // Re-initialize slot draggability
        makeSlotsDraggable();
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Error removing team from slot');
      });
    }

    makeSlotsDraggable();

    // Make slots droppable
    const slots = document.querySelectorAll('.slot-item');
    // console.log('Found ' + slots.length + ' slots');

    slots.forEach(slot => {
      slot.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        this.style.backgroundColor = '#c8e6c9';
        this.style.borderTop = '3px solid #4CAF50';
      });

      slot.addEventListener('dragleave', function(e) {
        this.style.backgroundColor = '';
        this.style.borderTop = '';
      });

      slot.addEventListener('drop', function(e) {
        e.preventDefault();
        e.stopPropagation();

        const teamId = e.dataTransfer.getData('text/plain');
        const sourceSlotId = e.dataTransfer.getData('slotId');
        const sourceType = e.dataTransfer.getData('source');
        const destSlotId = this.getAttribute('data-slot-id');
        const destSlotElement = this;

        this.style.backgroundColor = '';
        this.style.borderTop = '';

        // Check if this is a slot-to-slot swap (drag a slot onto another slot)
        if (sourceType === 'slot' && sourceSlotId && !teamId) {
          // console.log('Swapping slot', sourceSlotId, 'with slot', destSlotId);
          handleSlotSwap(sourceSlotId, destSlotId);
          return;
        }

        // Otherwise, this is a team-to-slot assignment
        // console.log('Dropping team', teamId, 'on slot', destSlotId);

        if (!teamId || !destSlotId) {
          console.error('Missing team or slot ID');
          return;
        }

        // Check if slot is already occupied
        const oldTeamId = destSlotElement.getAttribute('data-team-id');
        // console.log('Slot currently has team:', oldTeamId);

        // Get the team element from the list
        const teamElement = document.querySelector(`.team-item[data-team-id="${teamId}"]`);

        const token = document.querySelector('meta[name="csrf-token"]');
        if (!token) {
          console.error('CSRF token not found');
          return;
        }

        fetch(`/api/v1/slots/${destSlotId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': token.content
          },
          body: JSON.stringify({
            slot: {
              team_id: teamId
            }
          })
        })
        .then(response => {
          // console.log('Response status:', response.status);
          if (response.ok) {
            return response.json();
          } else {
            alert('Failed to assign team to slot');
            throw new Error('Failed to update slot');
          }
        })
        .then(data => {
          // console.log('Success! Data:', data);

          if (destSlotElement && data.slot && data.slot.team && data.slot.team.entries) {
            updateSlotUI(destSlotId, data.slot);
            // console.log('Slot updated from team drop');

            // Hide the new team from the list
            if (teamElement) {
              teamElement.style.display = 'none';
              // console.log('New team hidden from list');
            }

            // If there was an old team in the slot, show it back in the list
            if (oldTeamId && oldTeamId !== teamId) {
              const oldTeamElement = document.querySelector(`.team-item[data-team-id="${oldTeamId}"]`);
              if (oldTeamElement) {
                oldTeamElement.style.display = '';
                // console.log('Old team re-shown in list');
                makeEntriesDraggable(); // Re-enable drag on the re-shown team
              }
            }

            // Re-initialize slot draggability
            makeSlotsDraggable();
            makeEntriesDraggable(); // Re-enable drag on remaining visible entries
            refreshTeamList(); // Refresh the team list to ensure correct ordering
          } else {
            console.error('Missing slot or team data');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Error assigning team to slot');
        });
      });
    });

    // Make teams panel droppable (to remove teams from slots)
    const entriesPanel = document.querySelector('#teams .panel_contents');
    if (entriesPanel) {
      entriesPanel.addEventListener('dragover', function(e) {
        // Check if we're dragging from a slot (has slotId in types)
        const hasSlotId = e.dataTransfer.types.includes('slotid');
        if (hasSlotId) {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          this.style.backgroundColor = '#fff3e0';
          this.style.border = '3px dashed #FF9800';
        }
      });

      entriesPanel.addEventListener('dragleave', function(e) {
        this.style.backgroundColor = '';
        this.style.border = '';
      });

      entriesPanel.addEventListener('drop', function(e) {
        e.preventDefault();
        e.stopPropagation();

        this.style.backgroundColor = '';
        this.style.border = '';

        const slotId = e.dataTransfer.getData('slotId');
        const teamId = e.dataTransfer.getData('teamId');
        const source = e.dataTransfer.getData('source');

        if (source !== 'slot' || !slotId || !teamId) {
          console.log('Not a slot drag or missing data');
          return;
        }

        // console.log('Removing team', teamId, 'from slot', slotId);

        const token = document.querySelector('meta[name="csrf-token"]');
        if (!token) {
          console.error('CSRF token not found');
          return;
        }

        // Remove team from slot (set team_id to null)
        fetch(`/api/v1/slots/${slotId}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': token.content
          },
          body: JSON.stringify({
            slot: {
              team_id: null
            }
          })
        })
        .then(response => {
          if (response.ok) {
            return response.json();
          } else {
            alert('Failed to remove team from slot');
            throw new Error('Failed to update slot');
          }
        })
        .then(data => {
          // console.log('Team removed from slot successfully, teamId:', teamId);

          // Update slot to show "Empty"
          const slotElement = document.querySelector(`[data-slot-id="${slotId}"]`);
          if (slotElement) {
            slotElement.innerHTML = '<strong></strong><br>';
            slotElement.classList.remove('slot-item--occupied');
            slotElement.classList.add('slot-item--empty');

            // Remove data attributes
            slotElement.removeAttribute('data-team-id');
            slotElement.removeAttribute('data-team-name');
            slotElement.removeAttribute('data-hcp');
            slotElement.removeAttribute('data-teebox');
            slotElement.draggable = false;
            slotElement.style.cursor = '';
          }

          // Always reload the teams panel to ensure the team appears
          // console.log('Reloading teams panel to ensure team appears');
          const teamsPanel = document.querySelector('#teams .panel_contents');
          if (teamsPanel) {
            fetch(window.location.pathname, {
              headers: { 'Accept': 'text/html' }
            })
            .then(response => response.text())
            .then(html => {
              const parser = new DOMParser();
              const newDoc = parser.parseFromString(html, 'text/html');
              const newTeamsPanel = newDoc.querySelector('#teams .panel_contents');
              if (newTeamsPanel) {
                teamsPanel.innerHTML = newTeamsPanel.innerHTML;
                makeEntriesDraggable();
                // console.log('Teams panel reloaded successfully');
              } else {
                console.error('Could not find teams panel in response');
              }
            })
            .catch(error => {
              console.error('Error reloading teams panel:', error);
              // Fallback: try to show the team element if it exists
              const teamElement = document.querySelector(`.team-item[data-team-id="${teamId}"]`);
              if (teamElement) {
                teamElement.style.display = '';
                // console.log('Fallback: Team shown in list');
                makeEntriesDraggable();
              }
            });
          }

          // Re-initialize slot draggability
          makeSlotsDraggable();
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Error removing team from slot');
        });
      });
    }

    console.log('Drag & drop initialization complete');
  });
</script>
