<div id="teams">
  <div class="panel" style="width: 500px; background-color: #f9f9f9; border: 1px solid #ccc; border-radius: 4px;">

    <% teams = @start_list_teams %>
    <% team_ids_in_round_slots = @team_ids_in_round_slots %>

    <% available_teams = teams.reject { |team| team_ids_in_round_slots.include?(team.id) } %>

    <h3 data-team-total>Teams (Status: Enter) : <%= available_teams.count %></h3>
    <div class="panel_contents" style="overflow-y: auto; height: 400px;">

      <%# teams are prepared in app/admin/rounds.rb (prepare_start_list_data) %>

      <% resultcats = round.event.resultcats.sort_by(&:priority) %>
      <%= render "admin/rounds/status_info", available_teams: available_teams %>
      <% if resultcats.any? %>
        <% resultcats.each do |resultcat| %>
          <% cat_teams = available_teams.select { |team| team.resultcat_id == resultcat.id } %>
          <div class="resultcat-group" data-resultcat-id="<%= resultcat.id %>">
            <h4 style="background-color: yellow; padding: 5px; font-weight: bold;"><%= resultcat.name %> | <%= cat_teams.count { |item| item.status == 'enter' } %></h4>
            <% cat_teams.each do |team| %>
              <%= render "admin/rounds/team_item", team: team %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p>No teams with status 'enter' found.</p>
      <% end %>
    </div>
  </div>
</div>
