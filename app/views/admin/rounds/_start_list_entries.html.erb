<div id="teams">
  <div class="panel" style="width: 500px;">
    <h3>Teams (Status: Enter)</h3>
    <div class="panel_contents" style="overflow-y: auto; height: 400px;">
      <% teams = round.event.teams.where(status: :enter).includes(:resultcat, :entries, :slots) %>
      <% available_teams = teams.reject { |team| team.slots.any? } %>
      <% resultcats = round.event.resultcats.sort_by(&:name) %>
      <% if resultcats.any? %>
        <% resultcats.each do |resultcat| %>
          <% cat_teams = available_teams.select { |team| team.resultcat_id == resultcat.id } %>
          <div class="resultcat-group" data-resultcat-id="<%= resultcat.id %>">
            <h4 style="background-color: yellow; padding: 5px; font-weight: bold;"><%= resultcat.name %></h4>
            <% cat_teams.each do |team| %>
              <div class="team-item" data-team-id="<%= team.id %>" data-resultcat-id="<%= team.resultcat_id %>" style="<%= team.slots.any? ? 'display: none;' : '' %>">
                <strong><%= team.team_name %></strong>
                <br>
                <div style="display: flex; justify-content: center; align-items: center; gap: 5px;">
                  <div>HCP: <%= team.total_hcp %></div> 
                  <div>|</div> 
                  <div><%= team.entries.first.playercat.icon_teebox.html_safe %></div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p>No teams with status 'enter' found.</p>
      <% end %>
    </div>
  </div>
</div>