<div class="panel">
  <h3><%= @round.event.name %> : round <%= @round.num %> on <%= @round.date %></h3>
  <div class="panel_contents">
    <div style="margin-bottom: 15px; display: flex; gap: 10px; align-items: center;">
      <button id="refresh-start-list-btn" style="padding: 8px 16px; font-size: 1em; cursor: pointer; background-color: #1e88e5; color: white; border: none; border-radius: 4px;">
        Refresh
      </button>
      <%= button_to "Close", "/admin/rounds/#{@round.id}", method: :get, style: "padding: 8px 16px; font-size: 1em; cursor: pointer; background-color: darkred; color: white; border: none; border-radius: 4px;" %>
    </div>

    <%= render "admin/rounds/start_list_content", round: @round %>
  </div>
</div>

<script>
  $(document).ready(function() {
    $('#refresh-start-list-btn').on('click', function() {
      location.reload();
    });
  });
</script>
