<% if slot.team %>
  <div class="slot-item slot-item--occupied"
       data-slot-id="<%= slot.id %>"
       data-team-id="<%= slot.team.id %>"
       data-team-name="<%= slot.team.team_name %>"
       data-hcp="<%= slot.team.total_hcp %>">
    <strong><%= slot.team.team_name %></strong>
    <br>
    <div style="display: flex; justify-content: center; align-items: center; gap: 5px;">
          <div>HCP: <%= slot.team.total_hcp %></div>
    </div>
  </div>
<% else %>
  <div class="slot-item slot-item--empty" data-slot-id="<%= slot.id %>">
    <strong></strong>
    <br>
  </div>
<% end %>
