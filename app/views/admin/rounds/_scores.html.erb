<div id="scores-round">
  <div class="panel">
    <h3>Scores</h3>
    <div class="panel_contents">
      <% slots = round.config_teetimes.flat_map { |ct| ct.flights.flat_map(&:slots) }.select { |s| s.team.present? }.sort_by { |s| [s.flight.flight_time, s.num] } %>
      
      <% if slots.any? %>
        <div style="margin-bottom: 15px; display: flex; gap: 10px; align-items: center;">
          <input type="text" id="search-team-num" placeholder="Search team #..." style="padding: 8px; width: 200px; font-size: 1em;">
          <button id="refresh-scores-btn" style="padding: 8px 16px; font-size: 1em; cursor: pointer; background-color: #1e88e5; color: white; border: none; border-radius: 4px;">
            Refresh
          </button>
        </div>
        <table class="index_table" id="scores-table">
          <thead>
            <tr>
              <th></th>
              <th>@</th>
              <th>#</th>
              <th>Name</th>
              <th></th>
              <th></th>
              <th>Holes</th>
              <th>+-</th>
              <th>Brut</th>
              <th>Net</th>
              <th>Stb</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% slots.each do |slot| %>
              <% score = Score.find_or_create_by(round_id: round.id, slot_id: slot.id) do |s|
                s.entry = slot.team.entries.first
                s.status = :partial
              end %>
              <% scoring_class = "scoring-#{slot.team.resultcat&.scoring_short.downcase}" %>
              <% scoring_mode = slot.team.resultcat&.scoring_short.downcase %>
              <tr>
                <td><%= slot.flight.myTime %></td>
                <td><%= score.start_hole %></td>
                <td class="team-num"><%= slot.num %></td>
                <td class="text-left"><%= slot.team.name %></td>
                <td><%= slot.team.show_status %></td>
                <td>
                  <div class="<%= scoring_class %>">  
                    <%= slot.team.resultcat&.scoring_short %>
                  </div>
                </td>
                <td><%= score.hole_played %></td>
                <% scoring_mode == "sp" ? sp_score = score.stroke_play_score : sp_score = "x" %>
                <%# dans active admin views helper %>
                <td> 
                  <div class="div-against-par" style="<%= style_for_stroke_play(sp_score) %>"><strong><%= sp_score %></strong></div>
                </td>
                <td><%= scoring_mode == "sp" ? score.brut("total") : "x" %></td>
                <td><%= scoring_mode == "sp" ? score.net("total") : "x" %></td>
                <td><%= score.stb("total") %></td>
                <td>
                  <span class="status_tag <%= score.status %>"><%= score.status.humanize %></span>
                </td>
                <td>
                  <%= link_to "Edit Score", edit_admin_score_path(score), class: "button" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p>No slots with teams assigned for this round.</p>
      <% end %>
    </div>
  </div>
</div>
<script>
function init_search_team() {
  var searchInput = $('#search-team-num');
  var scoresRound = $('#scores-round');
  
  if (searchInput.length > 0 && scoresRound.is(':visible')) {
    searchInput.focus();
    searchInput.val('');
  }
}

$(document).ready(function() {
  // Check if we should show scores section after refresh
  if (sessionStorage.getItem('showScores') === 'true') {
    sessionStorage.removeItem('showScores');
    
    // Hide all sections
    $('#config-times, #start-list, #scores-round, #status, #round-details').hide();
    
    // Show only scores section
    $('#scores-round').show();
    
    // Update menu buttons
    $('.menu-event-button').removeClass('is-active');
    $('a[href="#scores-round"]').addClass('is-active');
  }
  
  init_search_team();
  
  // Refresh button handler
  $('#refresh-scores-btn').on('click', function() {
    sessionStorage.setItem('showScores', 'true');
    location.reload();
  });
  
  // Watch for visibility changes on scores-round
  var scoresRoundObserver = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.attributeName === 'style' || mutation.attributeName === 'class') {
        if ($('#scores-round').is(':visible')) {
          setTimeout(function() {
            init_search_team();
          }, 100);
        }
      }
    });
  });
  
  var scoresRound = document.getElementById('scores-round');
  if (scoresRound) {
    scoresRoundObserver.observe(scoresRound, {
      attributes: true,
      attributeFilter: ['style', 'class']
    });
  }
  
  // Also listen to turbo events
  $(document).on('turbo:load', function() {
    init_search_team();
  });
  
  $(document).on('keyup', '#search-team-num', function() {
    var searchValue = $(this).val().trim();
    var rows = $('#scores-table tbody tr');
    
    if (searchValue === '') {
      rows.show();
      return;
    }
    
    rows.each(function() {
      var teamNum = $(this).find('.team-num').text().trim();
      if (teamNum === searchValue) {
        $(this).show();
      } else {
        $(this).hide();
      }
    });
  });
  
  $(document).on('keypress', '#search-team-num', function(e) {
    if (e.which == 13) { // Enter key
      e.preventDefault();
      var searchValue = $(this).val().trim();
      var visibleRows = $('#scores-table tbody tr:visible');
      
      if (visibleRows.length === 1) {
        var editButton = visibleRows.find('a.button').first();
        if (editButton.length) {
          window.location.href = editButton.attr('href');
        }
      }
    }
  });
});
</script>