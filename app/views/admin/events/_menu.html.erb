<% current_page = local_assigns.fetch(:current_page, :entries).to_sym %>
<div name="event-menu" class="button-group" style="margin-top: -30px; margin-bottom: -20px;">
  <%= link_to "Dashboard", event_dashboard_admin_tour_event_path(event.tour, event), class: "menu-button#{' is-active' if current_page == :event_dashboard}" %>
  <%= link_to "Entries", entries_admin_tour_event_path(event.tour, event), class: "menu-button#{' is-active' if current_page == :entries}" %>
  <%= link_to "Rounds", rounds_admin_tour_event_path(event.tour, event), class: "menu-button#{' is-active' if current_page == :rounds}" %>
  <%= link_to "Leaderboard", leaderboard_admin_tour_event_path(event.tour, event), class: "menu-button#{' is-active' if current_page == :leaderboard}" %>
  <%= link_to "Player Categories", player_categories_admin_tour_event_path(event.tour, event), class: "menu-button#{' is-active' if current_page == :player_categories}" %>
  <%= link_to "Courses", courses_admin_tour_event_path(event.tour, event), class: "menu-button#{' is-active' if current_page == :courses}" %>
  <%= link_to "Event Details", event_details_admin_tour_event_path(event.tour, event), class: "menu-button#{' is-active' if current_page == :event_details}" %>
  <%= link_to event.status.upcase,
              event_status_admin_tour_event_path(event.tour, event),
              class: "menu-button menu-button-status#{' is-active' if current_page == :event_status}" %>
  <%= link_to "Close", admin_tour_path(event.tour), class: "menu-button btt-close" %>
</div>
