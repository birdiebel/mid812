<div id="entries">
 
  <%= render "admin/events/entries_find_players", event: event %>

  <div class="panel">
    <h3>Teams list</h3>
    <div class="panel_contents">
      <% if event.single? %>
        <%= render "admin/events/entries_list_single", event: event %>
      <% else %>
        <%= render "admin/events/entries_list_teams", event: event %>
      <% end %>
    </div>
  </div>

</div>
