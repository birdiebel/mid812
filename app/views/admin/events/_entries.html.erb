<div id="event-entries">
 
  <%= render "admin/events/entries_find_players", event: event %>

  <div class="panel">
    <h3>Entries list : <%= event.teams.joins(:entries).where(status: :enter).where.not(entries: { playercat_id: nil }).distinct.count %></h3>
    <div class="panel_contents">
      <% if event.single? %>
        <%= render "admin/events/entries_list_single", event: event %>
      <% else %>
        <%= render "admin/events/entries_list_teams", event: event %>
      <% end %>
    </div>
  </div>

</div>
