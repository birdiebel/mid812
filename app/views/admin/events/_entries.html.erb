<div id="entries">
  <div class="panel">
    <h3>Add a Player</h3>
    <div class="panel_contents">
      <div>
        <form action="<%= admin_tour_event_path(event.tour, event) %>" method="get">
          <div style="display: flex; gap: 10px; align-items: center;">
            <label>Find by name or licence number :</label>
            <input type="text" name="player_lastname" value="<%= params[:player_lastname] %>">
            <% if params[:team_id].present? %>
              <input type="hidden" name="team_id" value="<%= params[:team_id] %>">
              <span style="color: darkgreen; font-weight: bold;">Team selected: <%= Team.find(params[:team_id]).name rescue 'N/A' %></span>
            <% end %>
            <button type="submit">Find</button>
            <button type="button" onclick="window.location='<%= admin_tour_event_path(event.tour, event) %>'">Clear</button>
          </div>
        </form>
      </div>

      <% if params[:player_lastname].present? %>
        <div>
          <% players = Player
            .left_joins(:licences)
            .where("players.lastname ILIKE :query OR licences.num ILIKE :query", query: "%#{params[:player_lastname].strip}%")
            .where.not(id: Entry.where(event_id: event.id).select(:player_id))
            .limit(10) %>

          <h4 style="color: darkred;">Max 10 players show</h4>

          <% if players.any? %>
            <table>
              <thead>
                <tr>
                  <th>Cat</th>
                  <th>Nom complet</th>
                  <th>Genre</th>
                  <th>Licence</th>
                  <th>Club</th>
                  <th>Âge</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% players.each do |player| %>
                  <tr>
                    <td><%= player.icon_age_category %></td>
                    <td><%= player.full_name %></td>
                    <td><%= player.sexe %></td>
                    <td><%= player.my_licence %></td>
                    <td><%= player.my_club %></td>
                    <td><%= player.age %></td>
                    <td>
                      <% if player.licences.exists? %>
                        <% entry_params = { event_id: event.id, player_id: player.id } %>
                        <% if params[:team_id].present? %>
                          <% entry_params[:team_id] = params[:team_id] %>
                        <% end %>
                        <%= link_to "Ajouter", admin_entries_path(entry: entry_params), method: :post, class: "button" %>
                      <% else %>
                        <span style="color: red;">No licence found</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div>Aucun joueur trouvé.</div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="panel">
    <h3>Teams list</h3>
    <div class="panel_contents">
      <% if event.single? %>
        <% teams = event.teams.order(status: :asc, created_at: :desc) %>
        <table class="index_table">
          <tbody>
            <% teams.each do |team| %>
              <% entry = team.entries.first %>
              <% next unless entry %>
              <tr>
                <td><%= entry.player.icon_age_category %></td>
                <td><%= entry.player.full_name %></td>
                <td><%= entry.player.sexe %></td>
                <td><%= entry.player.age %></td>
                <td><%= entry.player.my_licence %></td>
                <td><%= entry.hcp %></td>
                <td><%= entry.playercat ? entry.playercat.name : "N/A" %></td>
                <td><%= entry.player.my_club %></td>
                <td><%= team.status %></td>
                <td><%= team.updated_at %></td>
                <td>
                  <%= button_to "Edit", edit_admin_team_path(team), method: :get, class: "btt btt-edit" %>
                </td>
                <td>
                  <%= button_to "Delete", admin_team_path(team), method: :delete, data: { confirm: "Are you sure?" }, class: "btt btt-cancel" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <% grouped_teams = event.teams.order(status: :asc, created_at: :desc).group_by(&:status) %>

        <% grouped_teams.each do |status, teams| %>
          <div class="panel-table-subtitre">
            Status :  <%= status.presence || 'Undefined' %> : <%= teams.count %>
          </div>

          <table class="index_table">
            <tbody>
              <% teams.each do |team| %>
                <% team_name = team.entries.map { |e| e.player.full_name }.join(" / ") %>
                <tr style="border-top: 2px solid black;">
                  <td></td>
                  <td style="background-color: lightgreen;"><strong><%= team_name.presence || team.name %></strong></td>
                  <td><%= team.status %></td>
                  <td><%= team.total_age %></td>
                  <td><%= team.updated_at %></td>
                  <td><%= team.total_hcp.round(1) %></td>
                  <td>
                    <%= button_to "Edit", edit_admin_team_path(team), method: :get, class: "btt btt-edit" %>
                  </td>
                  <td>
                    <% if (event.team? || event.bigteam?) && team.entries.size < event.max_players %>
                      <%= link_to "Add partner", admin_tour_event_path(event.tour, event, team_id: team.id, player_lastname: params[:player_lastname]), method: :get, class: "btt btt-add" %>
                    <% end %>
                  </td>
                  <td>
                    <%= button_to "Delete", admin_team_path(team), method: :delete, data: { confirm: "Are you sure?" }, class: "btt btt-cancel" %>
                  </td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                <% team.entries.each do |entry| %>
                  <tr>
                    <td><%= entry.player.icon_age_category %></td>
                    <td><%= entry.player.full_name %></td>
                    <td><%= entry.player.sexe %></td>
                    <td><%= entry.player.age %></td>
                    <td><%= entry.player.my_licence %></td>
                    <td><%= entry.hcp %></td>
                    <td><%= entry.playercat ? entry.playercat.name : "N/A" %></td>
                    <td><%= entry.player.my_club %></td>
                    <td>
                      <%= button_to "Edit", edit_admin_team_path(team), method: :get, class: "btt btt-edit" %>
                    </td>
                    <td>
                      <%= button_to "Remove", remove_from_team_admin_entry_path(entry), method: :put, data: { confirm: "Remove player from team?" }, class: "btt btt-cancel" %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        <% end %>
      <% end %>
    </div>
  </div>

</div>
