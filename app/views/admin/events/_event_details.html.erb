<div id="event-details" style="display:none;">
  <div class="panel">
    <h3>Event Details</h3>
    <div class="panel_contents">
      <table class="attributes_table">
        <tbody>
          <tr><th>Tour</th><td><%= event.tour.name %></td></tr>
          <tr><th>Name</th><td><%= event.name %></td></tr>
          <tr><th>Status</th><td><%= event.status %></td></tr>
          <tr><th>Format</th><td><%= event.format %></td></tr>
          <tr><th>Scoring</th><td><%= event.scoring %></td></tr>
          <tr><th>Date Event</th><td><%= event.date_event %></td></tr>
          <tr><th>Date Open</th><td><%= event.date_open %></td></tr>
          <tr><th>Date Close</th><td><%= event.date_close %></td></tr>
          <tr><th>Actif</th><td><%= event.actif %></td></tr>
          <tr><th>Nb Rounds</th><td><%= event.nb_rounds %></td></tr>
          <tr><th>Active Round</th><td><%= event.actif_round %></td></tr>
          <tr><th>Fee</th><td><%= event.fee %></td></tr>
          <tr><th>Fee Member</th><td><%= event.fee_member %></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
