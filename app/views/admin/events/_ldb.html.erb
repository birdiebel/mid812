<div id="ldb">
  <div class="panel">
    <h3>Rounds</h3>
    <div class="panel_contents">
      <% event.resultcats.order(priority: :asc).each do |r| %>
        <%= puts r.scoring %>
        <% if event.entries.exists? %>
          <% if r.scoring == "stroke_play"%>
            <%= render "admin/events/leaderboards/ldb_sp", event: event, r: r %>
          <% elsif r.scoring == "stableford"%>
            <%= render "admin/events/leaderboards/ldb_stb", event: event, r: r %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>