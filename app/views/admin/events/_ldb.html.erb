<div id="ldb">
  <div class="panel">
    <h3>Leaderboard</h3>
    <div class="panel_contents">
      <% if event.entries.exists? %>
        <div style="margin-bottom: 15px; display: flex; gap: 10px; align-items: center;">
          <input type="text" id="search-team-name" placeholder="Search team ..." style="padding: 8px;  font-size: 1em;" autocomplete="off">
        </div>
        <%# Boucle sur les catégories de résultats avec des équipes %>
        <% resultcat_ids_with_teams = event.teams.where(status: :enter).select(:resultcat_id) %>
        <% event.resultcats.where(id: resultcat_ids_with_teams).order(priority: :asc).each do |r| %>
          <% event_teams = event.teams_brut_totals_with_rounds(r.id) %>
          <% next if event_teams.blank? %>
          <%# stroke play or stableford %>
          <% if r.scoring == "stroke_play" %>
            <%= render "admin/events/leaderboards/ldb_sp", event: event, r: r, event_teams: event_teams %>
          <% elsif r.scoring == "stableford" %>
            <%= render "admin/events/leaderboards/ldb_stb", event: event, r: r, event_teams: event_teams %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
<script>
  $(document).ready(function() {
    $('#search-team-name').on('input', function() {
      var searchTerm = $(this).val().toLowerCase();
      $('#ldb .team-row').each(function() {
        var teamName = $(this).find('.team-name').text().toLowerCase();
        if (teamName.includes(searchTerm)) {
          $(this).show();
        } else {
          $(this).hide();
        }
      });
    });
  });
</script>
<script>
  (function($) {
    function isLdbPage() {
      return !!document.getElementById("ldb-external-page");
    }

    function resolveCableConsumer() {
      if (window.App && window.App.cable) return window.App.cable;
      if (!window.ldbCable && window.ActionCable) {
        window.ldbCable = window.ActionCable.createConsumer();
      }
      return window.ldbCable;
    }

    function cleanupLdbAutoReload() {
      if (window.ldbFallbackTimer) {
        window.clearInterval(window.ldbFallbackTimer);
        window.ldbFallbackTimer = null;
      }

      if (window.ldbRefreshSubscription) {
        const cable = resolveCableConsumer();
        if (cable) {
          cable.subscriptions.remove(window.ldbRefreshSubscription);
        }
        window.ldbRefreshSubscription = null;
      }
    }

    function bindLdbCableReload() {
      if (!isLdbPage()) {
        cleanupLdbAutoReload();
        return;
      }

      const eventId = <%= event.id.to_json %>;
      const cable = resolveCableConsumer();
      const fallbackMs = 60000;

      function startFallback() {
        if (window.ldbFallbackTimer) return;
        window.ldbFallbackTimer = window.setInterval(function() {
          if (!isLdbPage()) {
            cleanupLdbAutoReload();
            return;
          }
          window.location.reload();
        }, fallbackMs);
      }

      if (!eventId) return;

      startFallback();

      if (!cable) {
        return;
      }

      if (window.ldbRefreshSubscription) {
        cable.subscriptions.remove(window.ldbRefreshSubscription);
      }

      window.ldbRefreshSubscription = cable.subscriptions.create(
        { channel: "LdbRefreshChannel", event_id: eventId },
        {
          connected() {
            // Keep fallback active as safety net in case broadcasts are missed.
          },
          disconnected() {
            startFallback();
          },
          rejected() {
            startFallback();
          },
          received() {
            if (!isLdbPage()) return;
            window.location.reload();
          }
        }
      );
    }

    bindLdbCableReload();

    window.removeEventListener("hashchange", window.ldbHashChangeHandler);
    window.ldbHashChangeHandler = bindLdbCableReload;
    window.addEventListener("hashchange", window.ldbHashChangeHandler);

    document.removeEventListener("turbo:before-cache", window.ldbBeforeCacheHandler);
    window.ldbBeforeCacheHandler = cleanupLdbAutoReload;
    document.addEventListener("turbo:before-cache", window.ldbBeforeCacheHandler);

    window.removeEventListener("pagehide", window.ldbPageHideHandler);
    window.ldbPageHideHandler = cleanupLdbAutoReload;
    window.addEventListener("pagehide", window.ldbPageHideHandler);

    document.removeEventListener("turbo:load", window.ldbReloadHandler);
    window.ldbReloadHandler = bindLdbCableReload;
    document.addEventListener("turbo:load", window.ldbReloadHandler);
  })(jQuery);
</script>
