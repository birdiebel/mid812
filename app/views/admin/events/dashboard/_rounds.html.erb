<div>
  <div id="rounds-section">
    <% if event.rounds.any? %>
      <% event.rounds.order(:num).each do |round| %>
        <div>
          <div class="flex-start" style="align-items: center; margin-bottom: 10px;">
            <div style="background-color: #fca4a4; padding: 5px;"><strong>Round <%= round.num %>:</strong></div>
            <div style="margin-left: 5px;" id="round-open-btn-<%= round.id %>">
              <%= render partial: 'admin/events/dashboard/round_open_button', locals: { round: round } %>
            </div>
          </div>
          <%# Boutons de statut Round %>
          <div class="flex-start" style="padding-left: 20px;">
            <div>
              <strong>Status:</strong>
              <% teams_scoring_valid = round.teams_scoring_caution[1] %>
              <% start_list_valid = round.start_list_caution[1] %>
              <% Round.statuses.keys.each do |status_key| %>
                <%= puts("Status: #{status_key}, teams_scoring_valid: #{teams_scoring_valid}, start_list_valid: #{start_list_valid}"); %>
                <button
                  <%# Check if can running %>
                  <% if status_key == "running" %>
                    style="margin-right: 5px;<% if status_key == 'running' && !start_list_valid %> display: none;<% end %>"
                  <% end %>
                  <% if status_key == "suspended" %>
                    style="margin-right: 5px;<% if status_key == 'suspended' && !start_list_valid %> display: none;<% end %>"
                  <% end %>

                  <%# Check if can scoring %>
                  <% if status_key == "terminated" %>
                    style="margin-right: 5px;<% if status_key == 'terminated' && !teams_scoring_valid %> display: none;<% end %>"
                  <% end %>
                  <% if status_key == "suspended" %>
                    style="margin-right: 5px;<% if status_key == 'suspended' && !teams_scoring_valid %> display: none;<% end %>"
                  <% end %>
                  <%# Params button %>
                  data-status="<%= status_key %>"
                  data-round-id="<%= round.id %>"
                  class="round-status-btn btt <%= round.status == status_key ? 'btt-edit' : 'btt-add' %>"
                >
                  <%= status_key.upcase %>
                </button>
              <% end %>
              <span class="round-status-msg" style="margin-left: 10px; color: green;"></span>
            </div>
          </div>
          <%# Date, HCP % et Slots Occupied %>
          <div class="flex-start" style="padding-left: 20px;">
            <div><strong>Date:</strong> <%= round.date %></div>
            <div><strong>HCP %:</strong> <%= round.hcp_pc %></div>
            <div><strong>Slots Occupied:</strong> <%= round.slots_taked %></div>
          </div>
          <%# Config Teetimes %>
          <div class="flex-start" style="padding-left: 20px;">
            <% if round.config_teetimes.any? %>
              <% round.config_teetimes.each do |config_teetime| %>
                <div><strong>Config Teetime:</strong> <%= config_teetime.start_time&.strftime("%H:%M") %></div>
                <div><strong>Start Hole:</strong> <%= config_teetime.start_hole %></div>
              <% end %>
            <% else %>
              <div class="is_red">No config teetimes for this round.</div>
              <div><%= link_to "Manage Config Teetimes", config_times_admin_round_path(round), class: "btt btt-add" %></div>
            <% end %>
          </div>
          <%# Check start_list ready %>
          <div class="flex-start" style="padding-left: 20px;">
            <%= round.start_list_caution[0] %>
          </div>
          <%# Check teams scoring completed %>
          <div class="flex-start" style="padding-left: 20px;">
            <%= round.teams_scoring_caution[0] %>
          </div>
          <%# Spacer %>
          <div style="height: 20px;">&nbsp;</div>
        </div>
      <% end %>
    <% else %>
      <div class="flex-start">
        <p class="is_red">No rounds available.</p>
        <p><%= link_to "Manage Rounds", rounds_admin_tour_event_path(event.tour, event), class: "btt btt-add" %></p>
      </div>
    <% end %>
  </div>
</div>
<%# Script change status %>
<script>
  $(function() {
    $('.round-status-btn').on('click', function(e) {
      e.preventDefault();
      var $btn = $(this);
      var status = $btn.data('status');
      var roundId = $btn.data('round-id');
      var $msg = $btn.closest('div').find('.round-status-msg');
      $.ajax({
        url: '/admin/rounds/' + roundId + '/update_status',
        type: 'PATCH',
        contentType: 'application/json',
        data: JSON.stringify({ status: status }),
        headers: {
          'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
        },
        success: function(data) {
          // Update all buttons for this round
          var $btns = $btn.closest('div').find('.round-status-btn');
          $btns.prop('disabled', false)
            .removeClass('btt-edit').addClass('btt-add')
            .css({ fontWeight: '', background: '' });
          $btn.prop('disabled', true)
            .removeClass('btt-add').addClass('btt-edit')
            .css({ fontWeight: 'bold', background: '#b3e6b3' });
          $msg.text('Status updated : ' + status.toUpperCase());
          // Refresh the Open button for this round
          var $openBtnDiv = $('#round-open-btn-' + roundId);
          if ($openBtnDiv.length) {
            $.get('/admin/rounds/' + roundId + '/open_button', function(html) {
              $openBtnDiv.html(html);
            });
          }
          // Refresh event-section
          var eventId = $('#event-section .event-status-btn').first().data('event-id');
          if (eventId) {
            $.get('/admin/events/' + eventId + '/dashboard_event', function(html) {
              $('#event-section').html(html);
            });
          }
        },
        error: function(xhr) {
          var msg = 'Erreur : ' + (xhr.responseJSON && xhr.responseJSON.error ? xhr.responseJSON.error : 'inconnue');
          $msg.text(msg);
        }
      });
    });
  });
</script>