<table class="leaderboard-table">
  <tbody>
    <% event_teams ||= event.teams_brut_totals_with_rounds(r.id) %>
    <%# Titre Cat %>
    <tr>
      <td colspan="99" bgcolor="yellow" font-weight="bold">
        <%= r.name %> | <%= r.scoring.humanize %>
      </td>
    </tr>
    <% if event_teams.present? %>
      <tr>
        <th>Pos</th>
        <th>Team</th>
        <th>Hole</th>
        <% event.rounds.order(:num).each do |round| %>
          <th style="text-align: center;">R<%= round.num %></th>
        <% end %>
        <th>Stb</th>
      </tr>
    <% end %>
    <%# Row lbd %>
    <% event_teams&.each do |row| %>
      <tr class="team-row">
        <%# Position %>
        <td><%= row[:position] %></td>
        <%# Team Name %>
        <td style="text-align: left; font-weight: bold;" class="team-name"><%= row[:team].team_name_short %></td>
        <%# Holes Played %>
        <td><%= row[:team_hole_played] > 0 ? row[:team_hole_played] : "" %></td>
        <%# Each Round : score or start time %>
        <% event.rounds.order(:num).each do |round| %>
          <td>
            <% score = row[:stb_by_round][round.id] %>
            <% if score.nil? || score==0 %>
              <%= row[:team].start_time_for_round(round.id) %>
            <% else %>
              <%= score %>
            <% end %>
          </td>
        <% end %>
        <%# Stb %>
        <% if row[:stb_total] > 0 %>
          <td class="top-stb"><%= row[:stb_total] %></td>
        <% else %>
          <td></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
